{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/__clerk/:path*",
      "destination": "https://clerk.racepoint.ai/:path*"
    },
    {
      "source": "/asset-access",
      "destination": "https://asset-access-kappa.vercel.app/asset-access"
    },
    {
      "source": "/asset-access/:path*",
      "destination": "https://asset-access-kappa.vercel.app/asset-access/:path*"
    }
  ]
}
