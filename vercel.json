{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/unlock-vc.mjs": {
      "includeFiles": "private/unlock-vc.html",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/unlock-vc", "destination": "/api/unlock-vc" },
    { "source": "/unlock-vc.html", "destination": "/api/unlock-vc" },
    { "source": "/unlock-vc/:path*", "destination": "/api/unlock-vc" },
    {
      "source": "/asset-access",
      "destination": "https://asset-access-kappa.vercel.app/asset-access"
    },
    {
      "source": "/asset-access/:path*",
      "destination": "https://asset-access-kappa.vercel.app/asset-access/:path*"
    }
  ]
}
